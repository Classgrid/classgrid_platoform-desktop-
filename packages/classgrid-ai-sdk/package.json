{
  "name": "@classgrid/ai",
  "version": "0.1.0",
  "description": "The full-stack AI SDK for building intelligent, multi-channel AI agents with RAG, memory, tool calling, and provider fallback — built by Classgrid.",
  "author": "Nikhil Shinde <nikhil.shinde@classgrid.in>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js",
      "require": "./dist/rag/index.cjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./channels": {
      "types": "./dist/channels/index.d.ts",
      "import": "./dist/channels/index.js",
      "require": "./dist/channels/index.cjs"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js",
      "require": "./dist/guardrails/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "sdk",
    "rag",
    "llm",
    "multi-provider",
    "tool-calling",
    "vector-search",
    "mongodb",
    "redis",
    "whatsapp",
    "telegram",
    "email",
    "education",
    "erp",
    "classgrid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Classgrid/ai-sdk"
  },
  "homepage": "https://classgrid.in",
  "peerDependencies": {
    "@xenova/transformers": ">=2.14.0",
    "framer-motion": ">=10.0.0",
    "ioredis": ">=5.0.0",
    "mongoose": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@classgrid/gridx": "file:../gridx",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.300.0",
    "officeparser": "^7.8.0",
    "sonner": "^1.4.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
